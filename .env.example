# Copy to `.env` and edit. Used by docker-compose.yml.

# Directory on the host that holds your GGUF model files, and the filename to serve.
# PRIOR serves one model per engine. Keep the registry filename so the engine
# resolves the model's certified calibration (see MODELS.md).
MODELS_DIR=./models
MODEL=Llama-3.2-3B-Instruct-Q4_K_M.gguf

# GPU layers to offload: 99 = all (needs the NVIDIA Container Toolkit), 0 = CPU-only
# (also delete the engine `deploy:` block in docker-compose.yml for CPU-only).
PRIOR_NATIVE_NGL=99

# The policy switch: the single knob for detection + steering (they always move together).
#   on  = run the shipped detect+steer policy (default): harmful requests and destructive ops refused
#   off = byte-for-byte passthrough (no detection, no steering)
PRIOR_POLICY=on

# Host binding for the published ports. 127.0.0.1 = localhost only (default, secure).
# Set to 0.0.0.0 to expose on your network, then also uncomment PRIOR_REQUIRE_AUTH
# in docker-compose.yml, widen PRIOR_ALLOWED_ORIGINS, and use HTTPS.
PRIOR_PUBLISH_ADDR=127.0.0.1
